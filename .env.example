# 복사해서 .env 로 사용하세요 (.env 는 git 에 올리지 않습니다)

# 세션 서명 키 — 반드시 긴 랜덤 값으로 변경
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# 로그인 — 공용 계정. 암호는 여기 말고 .env.auth 에 해시로만 저장:
#   flask --app run set-login --user netnsecu   (암호를 두 번 물어봄, .env.auth 생성·권한 600)
# LOGIN_USER=netnsecu
# .env.auth 가 없을 때만 쓰는 로컬 개발용 평문 암호
ACCESS_PASSWORD=temp

# nginx 같은 리버스 프록시 뒤에서 운영할 때 true (실제 접속 IP·https 인식)
TRUST_PROXY=false

# HTTPS 로 운영할 때 true (Tailscale HTTPS / 리버스 프록시 사용 시)
SESSION_COOKIE_SECURE=false

# ---------- 저장 위치 (DB 없음, docs/storage.md) ----------
# 비우면 instance/ 폴더: notes/<프로젝트>/<노트>.md, uploads/, decks/, ai-chats/, ai-edits/, settings.json
# DATA_DIR=/srv/marknote-data

# ---------- AI 도우미 (Claude Code 구독 계정) ----------
# 방법 1 (권장): 서버를 실행하는 OS 사용자로 터미널에서 `claude` 실행 → 브라우저 로그인. 이 파일에 아무것도 안 넣어도 됨
# 방법 2: `claude setup-token` 으로 만든 1년짜리 토큰을 아래에 넣기 (API 키가 아님, 구독 사용량으로 동작)
# CLAUDE_CODE_OAUTH_TOKEN=
#
# ANTHROPIC_API_KEY 는 넣지 마세요 — 넣어도 앱이 Claude 실행 시 제거하지만, 구독이 아닌 API 요금 방식입니다.
#
# claude 실행 파일 위치 (PATH 에 없을 때만)
# CLAUDE_BIN=C:\Users\me\.local\bin\claude.exe
# 사용할 모델 (비우면 Claude Code 기본값), 응답 제한 시간(초)
# CLAUDE_MODEL=sonnet
# CLAUDE_TIMEOUT=300
